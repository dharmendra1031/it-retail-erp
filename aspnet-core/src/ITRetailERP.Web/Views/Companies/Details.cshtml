@model Company
@{
    ViewData["Title"] = "Company Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Company Details</h1>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
            {
                <img src="@Model.LogoPath" alt="Company logo" class="mb-3 border rounded" style="max-height: 100px;" />
            }

            <dl class="row mb-0">
                <dt class="col-sm-3">Company Name</dt>
                <dd class="col-sm-9">@Model.NameEn</dd>

                <dt class="col-sm-3">اسم الشركة</dt>
                <dd class="col-sm-9" dir="rtl">@Model.NameAr</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Model.AddressEn</dd>

                <dt class="col-sm-3">العنوان</dt>
                <dd class="col-sm-9" dir="rtl">@Model.AddressAr</dd>

                <dt class="col-sm-3">Telephone / Mobile</dt>
                <dd class="col-sm-9">@Model.Telephone @Model.Mobile</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Website</dt>
                <dd class="col-sm-9">@Model.Website</dd>

                <dt class="col-sm-3">VAT / Tax Number</dt>
                <dd class="col-sm-9">@Model.TaxNumber</dd>

                <dt class="col-sm-3">Commercial Registration</dt>
                <dd class="col-sm-9">@Model.CommercialRegistrationNumber</dd>

                <dt class="col-sm-3">Bank Details</dt>
                <dd class="col-sm-9 text-pre-wrap">@Model.BankDetails</dd>

                <dt class="col-sm-3">Invoice Header</dt>
                <dd class="col-sm-9 text-pre-wrap">@Model.InvoiceHeader</dd>

                <dt class="col-sm-3">Invoice Footer</dt>
                <dd class="col-sm-9 text-pre-wrap">@Model.InvoiceFooter</dd>

                <dt class="col-sm-3">Terms & Conditions</dt>
                <dd class="col-sm-9 text-pre-wrap">@Model.TermsAndConditions</dd>

                <dt class="col-sm-3">Social Media</dt>
                <dd class="col-sm-9 text-pre-wrap">@Model.SocialMedia</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
            </dl>
        </div>
    </div>
</div>
