@model IReadOnlyList<Company>
@{
    ViewData["Title"] = "Companies";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Company Master</h1>
            <div class="text-muted">Company Master / ملف الشركة</div>
        </div>
        <a asp-action="Create" class="btn btn-primary">Add Company</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Company</th>
                        <th>Arabic Name</th>
                        <th>Mobile</th>
                        <th>Tax No.</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No company has been added yet.</td>
                    </tr>
                }
                else
                {
                    foreach (var company in Model)
                    {
                        <tr>
                            <td>@company.NameEn</td>
                            <td dir="rtl">@company.NameAr</td>
                            <td>@company.Mobile</td>
                            <td>@company.TaxNumber</td>
                            <td>
                                <span class="badge @(company.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(company.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@company.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                <a asp-action="Edit" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@company.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
